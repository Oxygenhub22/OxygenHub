local function applyBWStyle(element, bgTrans)
	element.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
	element.BackgroundTransparency = bgTrans or 0.55 -- Resim net görünsün diye yarı saydam
	element.TextColor3 = Color3.fromRGB(255, 255, 255)
	element.TextStrokeTransparency = 0.5
	element.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	element.BorderColor3 = Color3.fromRGB(255, 255, 255)
	element.BorderSizePixel = 1
	element.ZIndex = 2
end

